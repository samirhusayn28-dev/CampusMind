rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User document and all nested collections
    match /users/{userId} {
      // User profile
      allow read, write: if isOwner(userId);

      // Lecture notes, AI study summaries, concept maps, and quizzes
      match /materials/{materialId} {
        allow read, write: if isOwner(userId);
      }

      // User preferences and configuration
      match /settings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }

      // Habit tracker, study streaks, and daily progress
      match /habits/{habitDoc} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any user subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other top-level collection access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
