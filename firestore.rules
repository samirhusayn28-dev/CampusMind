rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User document and all nested collections
    match /users/{userId} {
      // User profile document
      allow read, write: if isOwner(userId);

      // User's enrolled courses and subjects
      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // Lecture notes, AI study summaries, concept maps, and documents
      match /materials/{materialId} {
        allow read, write: if isOwner(userId);
      }

      // Habit tracker, study streaks, and daily check-offs
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // Completed quizzes, question sets, and scores
      match /quizzes/{quizId} {
        allow read, write: if isOwner(userId);
      }

      // User preferences and settings
      match /settings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any other user subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other top-level collection access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
