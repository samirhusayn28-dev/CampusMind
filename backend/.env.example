# CampusMind Backend Environment Variables (Vercel Serverless Deployment)

# 1. Groq Cloud API Key
# Used for: LLaMA 3.3 70B Summarization, Roman Urdu/Urdu Translation, Practice Quiz Generation, and Whisper Audio Transcription
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Pinecone Vector Database
# Used for: RAG Semantic Search over lecture materials
# Integrated Embedding: llama-text-embed-v2 (1024 dim, cosine metric)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX=campusmind-index

# 3. Google Cloud Vision API
# Used for: Handwritten notes OCR document text detection
GOOGLE_VISION_API_KEY=AIzaSy_your_google_vision_api_key_here
# Optional fallback for service account JSON:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
